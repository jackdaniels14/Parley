rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // === Helpers ===
    function isAuth() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    function isModerator() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true;
    }

    function isValidStance(stance) {
      return stance in ['love', 'hate', 'neutral'];
    }

    // Protected user fields that only Cloud Functions can modify
    function userProtectedFields() {
      return ['email', 'username', 'isModerator', 'createdAt',
              'rank', 'rankPoints', 'totalDebates', 'wins', 'losses', 'draws',
              'winStreak', 'bestWinStreak', 'upsetWins',
              'avgLogicScore', 'avgEvidenceScore', 'avgOnTopicScore', 'avgCrowdScore',
              'judgeScore'];
    }

    // === Users ===
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if false; // Cloud Function only (registerUsername)
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(userProtectedFields());
      allow delete: if false;

      // Topic preferences
      match /preferences/{topicId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && isValidStance(request.resource.data.stance)
          && request.resource.data.keys().hasAll(['stance', 'source', 'confidence', 'createdAt']);
        allow update: if isOwner(uid)
          && isValidStance(request.resource.data.stance);
        allow delete: if isOwner(uid);
      }

      // Settings (notifications, privacy, etc.)
      match /settings/{settingId} {
        allow read, write: if isOwner(uid);
      }

      // Topic credibility (competitive stats per topic)
      match /topicCredibility/{topicId} {
        allow read: if isAuth();
        allow write: if false; // Cloud Function only
      }

      // Judge profile (merit-based judging stats)
      match /judgeProfile/{docId} {
        allow read: if isAuth();
        allow write: if false; // Cloud Function only
      }

      // Debate history
      match /debateHistory/{debateId} {
        allow read: if isOwner(uid);
        allow write: if false; // Cloud Function only
      }

      // Social accounts
      match /socialAccounts/{provider} {
        allow read: if isOwner(uid);
        allow write: if false; // Cloud Function only
      }
    }

    // === Usernames (uniqueness enforcement) ===
    match /usernames/{username} {
      allow read: if true;
      allow write: if false; // Cloud Function only
    }

    // === Topics ===
    match /topics/{topicId} {
      allow read: if true;
      allow write: if false; // Cloud Function only
    }

    // === Debates ===
    match /debates/{debateId} {
      allow read: if isAuth();
      allow write: if false; // All lifecycle managed by Cloud Functions

      // Rounds subcollection
      match /rounds/{roundNumber} {
        allow read: if isAuth();
        allow write: if false; // Cloud Function only
      }
    }

    // === Arguments (structured debate content) ===
    match /arguments/{argumentId} {
      allow read: if isAuth();
      allow write: if false; // Cloud Function only (submitArgument)
    }

    // === Votes (crowd judging with composite ID) ===
    match /votes/{voteId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && voteId == request.resource.data.debateId + '_' + request.auth.uid
        && request.resource.data.voterId == request.auth.uid
        && request.resource.data.persuasivenessWinner in ['for', 'against', 'draw']
        && request.resource.data.betterLogic in ['for', 'against', 'equal']
        && request.resource.data.betterEvidence in ['for', 'against', 'equal']
        && request.resource.data.moreOnTopic in ['for', 'against', 'equal']
        && request.resource.data.moreRespectful in ['for', 'against', 'equal']
        && request.resource.data.keys().hasAll([
          'debateId', 'voterId', 'persuasivenessWinner',
          'betterLogic', 'betterEvidence', 'moreOnTopic', 'moreRespectful',
          'changedMind', 'voterJudgeScore', 'createdAt'
        ]);
      allow update: if false; // No changing votes
      allow delete: if false;
    }

    // === Argument Reactions (direct client writes with composite ID) ===
    match /argumentReactions/{reactionId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && reactionId == request.auth.uid + '_' + request.resource.data.argumentId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.reactionType in ['persuasive', 'strongLogic', 'goodEvidence', 'respectful'];
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.argumentId == resource.data.argumentId
        && request.resource.data.reactionType in ['persuasive', 'strongLogic', 'goodEvidence', 'respectful'];
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // === Matchmaking Queue ===
    match /matchmakingQueue/{entryId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow write: if false; // Cloud Function only
    }

    // === Challenges ===
    match /challenges/{challengeId} {
      allow read: if isAuth()
        && (resource.data.challengerId == request.auth.uid
         || resource.data.challengedId == request.auth.uid);
      allow write: if false; // Cloud Function only
    }

    // === Debate Results ===
    match /debateResults/{debateId} {
      allow read: if isAuth();
      allow write: if false; // Cloud Function only
    }

    // === Social Clips (public for sharing) ===
    match /socialClips/{clipId} {
      allow read: if true;
      allow write: if false; // Cloud Function only
    }

    // === Reports ===
    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if isAuth()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasAll(['targetType', 'targetId', 'reporterId', 'reason', 'status', 'createdAt'])
        && request.resource.data.targetType in ['argument', 'user', 'debate', 'clip'];
      allow update: if false; // Cloud Function only
      allow delete: if false;
    }

    // === Moderator Actions (visible to all debate watchers) ===
    match /moderatorActions/{actionId} {
      allow read: if isAuth();
      allow write: if false; // Cloud Function only
    }

    // === Leaderboards (public) ===
    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if false; // Cloud Function only
    }

    // === Social Tokens (admin-only) ===
    match /socialTokens/{tokenId} {
      allow read, write: if false; // Admin SDK only
    }
  }
}
