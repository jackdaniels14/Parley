rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the requesting user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // Helper: check if the requesting user is the document owner
    function isOwner(uid) {
      return isAuth() && request.auth.uid == uid;
    }

    // Helper: check if user is a moderator
    function isModerator() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isModerator == true;
    }

    // Helper: validate stance value
    function isValidStance(stance) {
      return stance in ['love', 'hate', 'neutral'];
    }

    // Users collection
    match /users/{uid} {
      allow read: if isAuth();
      allow create: if false; // Created via Cloud Function (registerUsername)
      allow update: if isOwner(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'username', 'isModerator', 'createdAt']);
      allow delete: if false;

      // User preferences subcollection
      match /preferences/{topicId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && isValidStance(request.resource.data.stance)
          && request.resource.data.keys().hasAll(['stance', 'source', 'confidence', 'createdAt']);
        allow update: if isOwner(uid)
          && isValidStance(request.resource.data.stance);
        allow delete: if isOwner(uid);
      }

      // Settings subcollection
      match /settings/{settingId} {
        allow read, write: if isOwner(uid);
      }

      // Social accounts subcollection
      match /socialAccounts/{provider} {
        allow read: if isOwner(uid);
        allow write: if false; // Managed via Cloud Functions
      }

      // Debate history subcollection
      match /debateHistory/{debateId} {
        allow read: if isOwner(uid);
        allow write: if false; // Managed via Cloud Functions
      }
    }

    // Usernames collection (enforces uniqueness)
    match /usernames/{username} {
      allow read: if true; // Public read for availability checking
      allow write: if false; // Managed via Cloud Function (registerUsername)
    }

    // Topics collection
    match /topics/{topicId} {
      allow read: if true; // Public read
      allow write: if false; // Managed via Cloud Function (manageTopic) to enforce slug uniqueness
    }

    // Debates collection
    match /debates/{debateId} {
      allow read: if isAuth();
      allow write: if false; // Managed via Cloud Functions
    }

    // Posts collection (flat)
    match /posts/{postId} {
      allow read: if isAuth();
      allow write: if false; // Managed via Cloud Functions (content moderation)
    }

    // Reactions collection
    match /reactions/{reactionId} {
      allow read: if isAuth();
      allow create: if isAuth()
        && reactionId == request.auth.uid + '_' + request.resource.data.postId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.reactionType in ['changed_mind', 'good_point', 'fair_disagree'];
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.reactionType in ['changed_mind', 'good_point', 'fair_disagree']
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.postId == resource.data.postId;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if isModerator();
      allow create: if isAuth()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.keys().hasAll(['postId', 'reporterId', 'reason', 'status', 'createdAt']);
      allow update: if false; // Managed via Cloud Function (actionReport)
      allow delete: if false;
    }

    // Social tokens (admin-only)
    match /socialTokens/{tokenId} {
      allow read, write: if false; // Admin SDK only
    }
  }
}
